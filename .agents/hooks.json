{
  "rtk-rewrite": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook antigravity"
          }
        ]
      }
    ]
  },
  "omni-buffer-update": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python .agents/hooks/pre-agent-wake.py --hook"
      }
    ]
  }
}
