{
  "rtk-rewrite": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|execute_command|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 hooks/rtk-pre-tool.py antigravity"
          }
        ]
      }
    ]
  },
  "omni-buffer-update": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "python -X utf8 hooks/pre-agent-wake.py --hook"
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python -X utf8 hooks/pre-agent-wake.py --hook"
      }
    ]
  }
}
